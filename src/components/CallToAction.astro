---
import { pageLanguage } from '../lib/languages'
import StoreBadges from './StoreBadges.astro'
import { googlePlayUrl, itchIoUrl, webGameUrl } from '../lib/stores'

/**
 * CallToAction Component
 *
 * @description A prominent call-to-action section with a title and link
 */
interface Props {
  showBrowserPlay?: boolean
  /**
   * The title text to display
   * @default "Get this theme on GitHub"
   */
  title?: string
  /**
   * The URL the button should link to
   * @default "https://github.com/incluud/accessible-astro-starter"
   */
  link?: string
  /**
   * The text to display on the button
   * @default "Get Started"
   */
  linkText?: string
}

const de = pageLanguage(Astro.url) === 'de'
const {
  showBrowserPlay = false,
  title = de ? 'Quick Dungeon Crawler herunterladen' : 'Download Quick Dungeon Crawler',
  link = googlePlayUrl,
  linkText = de ? 'Bei Google Play laden – Quick Dungeon Crawler für Android' : 'Get Quick Dungeon Crawler on Google Play',
}: Props = Astro.props
---

<div class="container" id={showBrowserPlay ? 'play' : undefined}>
  <div class="call-to-action mt-24 mb-32 flex flex-col items-center gap-12 rounded-xl px-12 py-20 md:px-24">
    <h2 class="text-center text-3xl md:text-6xl">{title}</h2>
    <p class="max-w-prose text-center">{de ? 'Werbefrei · Offline spielbar · 100 % Open Source' : 'No ads · Offline play · 100% open-source'}</p>
    <div class="flex flex-col items-center gap-3 text-center">
      {showBrowserPlay && <a class="button color-secondary" href={webGameUrl}>
        {de ? 'Im Browser spielen' : 'Play in your browser'}
      </a>}
      <StoreBadges class="justify-center" googlePlayLink={link} googlePlayText={linkText} />
      <a href={itchIoUrl} class="inline-flex min-h-11 items-center text-inherit underline underline-offset-4">
        {de ? 'Windows-Version auf itch.io kaufen' : 'Buy the Windows edition on itch.io'}
      </a>
    </div>
  </div>
</div>

<style lang="scss">
  @use '../assets/scss/base/mixins' as *;

  .call-to-action {
    position: relative;
    isolation: isolate;
    border: 1px solid light-dark(transparent, var(--color-neutral-700));
    background-color: light-dark(var(--color-neutral-900), var(--color-neutral-800));
    overflow: hidden;
    color: var(--color-neutral-100);

    &::before {
      position: absolute;
      inset: 0;
      z-index: -1;
      background-image: radial-gradient(
        ellipse 80% 100% at 50% 0%,
        oklch(from var(--brand-primary) 45% c h / 0.55),
        transparent 70%
      );
      content: '';
    }
  }
</style>
