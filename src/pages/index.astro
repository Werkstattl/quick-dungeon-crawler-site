---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import Counter from '@components/Counter.astro'
import ExternalLink from '@components/ExternalLink.astro'
import BlockQuote from '@components/BlockQuote.astro'
import screenshots from '@assets/img/screenshots.png'
import trailerThumbnail from '@assets/img/qdc-gameplay-trailer.webp'
import { Image } from 'astro:assets'
---

<DefaultLayout title="Home" description="Quick Dungeon Crawler – a casual roguelite for mobile and web. Loot, die, repeat. No ads, offline play, open-source.">
  <Hero />

  <section class="my-32" aria-labelledby="gameplay-trailer-heading">
    <div class="container">
      <div class="mx-auto max-w-5xl">
        <div class="mb-8 text-center">
          <h2 id="gameplay-trailer-heading" class="text-4xl sm:text-5xl md:text-6xl">Watch the gameplay trailer</h2>
          <p class="mt-4 text-xl">See the dungeon, combat, loot, and progression in action.</p>
        </div>
        <a
          class="group relative block aspect-video overflow-hidden rounded-lg border border-solid border-current"
          href="https://www.youtube.com/watch?v=CDArsS_qMyc"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Watch the Quick Dungeon Crawler gameplay trailer on YouTube (opens in a new tab)"
        >
          <Image
            class="h-full w-full object-cover transition-transform duration-200 group-hover:scale-[1.02]"
            src={trailerThumbnail}
            alt=""
            width={1280}
            height={720}
            loading="lazy"
            decoding="async"
          />
          <span
            class="absolute inset-0 flex items-center justify-center bg-black/10 transition-colors group-hover:bg-black/20"
            aria-hidden="true"
          >
            <span class="flex h-20 w-20 items-center justify-center rounded-full bg-black/80 text-white shadow-lg">
              <svg class="ml-1 h-9 w-9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M8 5v14l11-7z"></path>
              </svg>
            </span>
          </span>
        </a>
        <p class="mt-4 text-center">
          <ExternalLink href="https://www.youtube.com/watch?v=CDArsS_qMyc">
            Watch on YouTube
          </ExternalLink>
        </p>
      </div>
    </div>
  </section>

  <section class="my-32">
    <div class="space-content container">
      <h2 class="text-6xl">Player reviews</h2>
      <BlockQuote
        author="★ ★ ★ ★ ★ Brandon F., Google Play review, 31 May 2025"
      >
        I was suspicious at first. But it's hella fun!
      </BlockQuote>
      <p class="mt-2">
        <ExternalLink
          href="https://play.google.com/store/apps/details?id=com.thomaspeissl.quick_dungeon_crawler_od.twa&showAllReviews=true&gl=EU&hl=en_US&reviewId=44c7663a-bd56-458c-979c-b7c32975f4e0"
        >
          Read on Google Play
        </ExternalLink>
      </p>
      <br>

      <BlockQuote
        author="★ ★ ★ ★ ★ TJ, Google Play review, 16 June 2025"
      >
        Enjoyable experience.
      </BlockQuote>
      <p class="mt-2">
        <ExternalLink
          href="https://play.google.com/store/apps/details?id=com.thomaspeissl.quick_dungeon_crawler_od.twa&showAllReviews=true&gl=EU&hl=en_US&reviewId=86b3f68a-5647-4220-b05f-824487bce00c"
        >
          Read on Google Play
        </ExternalLink>
      </p>
      <br>

      <BlockQuote
        author="★ ★ ★ ★ Zer O J., Google Play review, 25 June 2025"
      >
        ... maybe add something that the player may remember to check, maybe forging tokens 🤣
      </BlockQuote>
      <p class="mt-2">
        <ExternalLink
          href="https://play.google.com/store/apps/details?id=com.thomaspeissl.quick_dungeon_crawler_od.twa&showAllReviews=true&gl=EU&hl=en_US&reviewId=fd2fe3af-7454-40f3-975f-0495ed1cc75d"
        >
          Read on Google Play
        </ExternalLink>
      </p>
      <br>

      <p class="text-sm italic mt-4">
        Displayed here are all reviews rated 4★ and above.
      </p>
    </div>
  </section>

  <Image class="w-full max-w-3xl mx-auto" src={screenshots} alt="Screenshots of the game" decoding="async" width={800} height={600} loading="eager" />

  <section class="mt-64 mb-32">
    <div class="container">
      <h2 class="mb-16 text-6xl">Impact in numbers</h2>
      <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 md:grid-cols-4">
        <Counter count="30+" title="Stars" sub="On GitHub" />
        <Counter count="4.6★" title="Rating" sub="Google Play" />
        <Counter count="900+" title="Commits" sub="Merged" />
        <Counter count="2+" title="Years" sub="In development" />
      </div>
    </div>
  </section>
</DefaultLayout>

<style>
  .avatar {
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-s);
  }
</style>
