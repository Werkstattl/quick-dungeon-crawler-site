---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import CallToAction from '@components/CallToAction.astro'
import Counter from '@components/Counter.astro'
import Feature from '@components/Feature.astro'
import ExternalLink from '@components/ExternalLink.astro'
import characterBuildScreenshot from '@assets/img/gameplay/paladin-build.webp'
import explorationScreenshot from '@assets/img/gameplay/wolf-pup-exploration.webp'
import bossCombatScreenshot from '@assets/img/gameplay/ant-queen-crypt.webp'
import trailerThumbnail from '@assets/img/qdc-gameplay-trailer.webp'
import { Image } from 'astro:assets'
import { appStoreUrl, googlePlayUrl, itchIoUrl } from '../lib/stores'
import { publisher } from '../lib/structured-data'
import { pages, pageLanguage } from '../lib/languages'

const lang = pageLanguage(Astro.url)
const de = lang === 'de'
const pageTitle = de
  ? 'Quick Dungeon Crawler – Offline-Rollenspiel für Android, iOS und Mac'
  : 'Quick Dungeon Crawler – Offline RPG for Android, iOS & Mac'
const pageDescription = de
  ? 'Erkunde Dungeons, sammle Ausrüstung und besiege Bosse. Spiele das kostenlose Roguelite-Rollenspiel auf Deutsch im Browser, auf Android, iPhone, iPad und Mac.'
  : 'Play Quick Dungeon Crawler on Android, iPhone, iPad, Mac with Apple silicon or the web. A free offline roguelite RPG with no ads. Loot, die, repeat.'
const trailerUrl = 'https://www.youtube.com/watch?v=CDArsS_qMyc'
const siteUrl = Astro.site ?? new URL(Astro.url.origin)

const formatDate = new Intl.DateTimeFormat(de ? 'de-DE' : 'en-GB', { dateStyle: 'long', timeZone: 'UTC' })
const reviewsBaseUrl = `${googlePlayUrl}&showAllReviews=true&gl=EU&hl=en_US&reviewId=`

const reviews = [
  {
    rating: 5,
    quote:
      'Pretty good experience so far, looks like a real gem in this day in age! Props to the devs, I can’t wait to see what they add next!',
    author: 'Rick A',
    date: '2026-08-22',
    link: `${reviewsBaseUrl}0bf68797-f59c-4b6e-a053-9070371759de`,
  },
  {
    rating: 5,
    quote:
      'Simply addictive. Easy to load game that you can load offline. The gaming mechanisms is simple, retro like, which makes it very easy to turn off brain, read text, chill and fight monsters in the dungeon.',
    author: 'Grace Yeung',
    date: '2026-01-08',
    link: `${reviewsBaseUrl}2e85f77a-18ae-4236-8738-83ce8050dd4d`,
  },
  {
    rating: 5,
    quote:
      'Really good RPG. You can build your character with a great variety of attributes. The game gets harder the more you progress, so manage your stats and equipment wisely.',
    author: 'Samukazai',
    date: '2025-10-27',
    link: `${reviewsBaseUrl}82821435-2697-4335-b6ae-adb6effd6336`,
  },
  {
    rating: 5,
    quote:
      'The developers are incredible! They listen to feedback and will implement it if it jives with their vision. I cannot say a bad thing. I’ll definitely get part 2 if they make it.',
    author: 'Joe Sobczak',
    date: '2025-10-10',
    link: `${reviewsBaseUrl}85d8a92f-0bed-4383-bc9d-0137ecde56ae`,
  },
  {
    rating: 5,
    quote:
      'Found off a reddit post and gave it a try for a few hours. first impressions are that it’s pretty simple but fun text based rpg/clicker. No major IAPs or Ads that bog down the game which is always welcomed',
    author: 'Matt S',
    date: '2025-09-02',
    link: `${reviewsBaseUrl}15f751aa-f66f-457e-a7a9-bea305ec0e2c`,
  },
  {
    rating: 5,
    quote:
      'great game simple quick and effective. you’re able to take this game on the go without committing too much time or energy! love this and will recommend it!',
    author: 'Welly C',
    date: '2025-07-27',
    link: `${reviewsBaseUrl}40d7cc19-8e41-468f-bb70-383313a35efb`,
  },
]

const gameData = {
  '@type': ['VideoGame', 'SoftwareApplication'],
  '@id': new URL('/#game', siteUrl).href,
  name: 'Quick Dungeon Crawler',
  alternateName: 'Quick Dungeon Crawler on Demand',
  url: siteUrl.href,
  image: new URL('/social-preview-image.png', siteUrl).href,
  description: pageDescription,
  genre: ['Roguelite', 'Role-playing game', 'Dungeon crawler'],
  gamePlatform: ['Android', 'iOS', 'iPadOS', 'macOS (Apple silicon)', 'Web browser'],
  applicationCategory: 'GameApplication',
  operatingSystem: 'Android, iOS, iPadOS, macOS (Apple silicon), Web browser',
  installUrl: [googlePlayUrl, appStoreUrl],
  sameAs: [googlePlayUrl, appStoreUrl, itchIoUrl],
  author: {
    '@type': 'Organization',
    name: 'Werkstattl',
    url: 'https://werkstattl.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Werkstattl',
    url: 'https://werkstattl.com',
  },
  offers: [googlePlayUrl, appStoreUrl].map((url) => ({
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
    url,
  })),
  trailer: {
    '@type': 'VideoObject',
    name: de ? 'Gameplay-Trailer zu Quick Dungeon Crawler' : 'Quick Dungeon Crawler gameplay trailer',
    description: de
      ? 'Ein Blick auf Kämpfe, Beute und Erkundung im Dungeon.'
      : 'See the dungeon, combat, loot, and progression in action.',
    thumbnailUrl: new URL(trailerThumbnail.src, siteUrl).href,
    uploadDate: '2026-08-01T08:44:47Z',
    url: trailerUrl,
    embedUrl: 'https://www.youtube.com/embed/CDArsS_qMyc',
  },
}
const structuredData = {
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', siteUrl).href,
      url: siteUrl.href,
      name: 'Quick Dungeon Crawler',
      alternateName: 'Quick Dungeon Crawler on Demand',
      description: pageDescription,
      inLanguage: ['en', 'de'],
      publisher,
      about: { '@id': gameData['@id'] },
    },
    gameData,
  ],
}
const features = [
  {
    icon: 'lucide:dices',
    title: de ? 'Jeder Lauf ist anders' : 'Endless randomized runs',
    body: de
      ? 'In jedem Lauf erwarten dich neue Etagen, Gegner und Beute. Im normalen Modus behältst du deine Ausrüstung und dein Gold, wenn du stirbst.'
      : 'Each run has new floors, enemies and loot. In Normal mode, you keep your gear and gold when you die.',
  },
  {
    icon: 'lucide:swords',
    title: de ? 'Dein Held, dein Spielstil' : 'Build your character',
    body: de
      ? 'Wähle eine Klasse und eine passive Fähigkeit. Verteile deine Punkte und erhöhe die Fluchstufe, sobald du mehr Herausforderung suchst.'
      : 'Pick a class, spend your stats, choose a passive — and take a Curse when you want a harder run.',
  },
  {
    icon: 'lucide:hammer',
    title: de ? 'Ausrüstung nach Maß' : 'Forge your gear',
    body: de
      ? 'In der Schmiede kannst du Ausrüstung veredeln, Werte neu würfeln und gute Werte sperren. So bereitest du dich auf den nächsten Boss vor.'
      : 'Upgrade, reroll and lock equipment stats in the Forge to push your build past the next boss.',
  },
  {
    icon: 'lucide:paw-print',
    title: de ? 'Begleiter im Kampf' : 'Fight with companions',
    body: de
      ? 'Rufe einen Begleiter an deine Seite. Er kämpft mit dir und bringt eigene Boni für deinen Lauf mit.'
      : 'Summon companions that fight at your side and add bonuses to the rest of your run.',
  },
  {
    icon: 'lucide:wifi-off',
    title: de ? 'Offline spielen' : 'Plays offline',
    body: de
      ? 'Einmal geladen, läuft das Spiel auf deinem Gerät. So kannst du auch im Zug oder im Flugzeug weiterspielen.'
      : 'Once loaded, the whole game runs on your device — on the train, on a plane, anywhere.',
  },
  {
    icon: 'lucide:heart-handshake',
    title: de ? 'Werbefrei und kostenlos' : 'No ads, no paywalls',
    body: de
      ? 'Quick Dungeon Crawler ist Open Source. Du spielst kostenlos, ohne Werbung, Pflichtkäufe oder Tracking.'
      : 'Free and 100% open-source, with no ads, no forced purchases and no tracking.',
  },
]
---

<DefaultLayout title={pageTitle} description={pageDescription} {structuredData} showFooterDownload={false}>
  <Hero />

  <section class="my-16" aria-labelledby="encounter-heading">
    <div class="container">
      <div class="mx-auto grid max-w-4xl items-center gap-6 md:grid-cols-2 md:gap-12">
        <div class="text-center md:text-left">
          <h2 id="encounter-heading" class="text-4xl sm:text-5xl md:text-6xl">
            {de ? 'Kämpfen oder fliehen?' : 'Engage or flee?'}
          </h2>
          <p class="mt-4 text-xl">
            {de
              ? 'Gleich im ersten Raum versperrt ein Skelettritter Rowan und dem Wolfswelpen den Weg.'
              : 'In the very first room, a Skeleton Knight blocks the path ahead of Rowan and the Wolf Pup.'}
          </p>
        </div>
        <Image
          class="h-auto w-full max-w-xs justify-self-center rounded-lg border border-solid border-current"
          src={explorationScreenshot}
          alt={de
            ? 'Spielszene auf Etage 1 mit den Optionen „Engage“ (kämpfen) und „Flee“ (fliehen).'
            : 'Floor 1 encounter log with the Engage and Flee options below the Skeleton Knight encounter.'}
          width={540}
          height={960}
          decoding="async"
        />
      </div>
    </div>
  </section>

  <section class="my-16" aria-labelledby="wiki-heading">
    <div class="container">
      <div class="rounded-xl border border-solid border-current p-6 sm:p-10">
        <p class="mb-3 text-sm font-semibold tracking-widest uppercase">{de ? 'Wiki & Spieltipps' : 'Wiki & Guides'}</p>
        <h2 id="wiki-heading" class="text-3xl sm:text-4xl">
          {de ? 'Dein erster Lauf im Dungeon' : 'Your next run starts with a little know-how.'}
        </h2>
        <p class="mt-4 max-w-3xl">
          {
            de ? (
              <>
                Welche Ausrüstung lohnt sich? Was bleibt dir, wenn du stirbst? Der Einsteigerguide begleitet dich durch
                deinen ersten Lauf. In den FAQ findest du Antworten zu Fluchstufen, Gold und Begleitern.
              </>
            ) : (
              <>
                New to the dungeon? Get help with <a href="/wiki/curse/">Curse</a>, <a href="/wiki/gold/">gold</a>,{' '}
                <a href="/wiki/equipment/">equipment tiers</a>, <a href="/wiki/refining/">refining</a> and{' '}
                <a href="/wiki/luck/">Luck</a>, or find a quick answer to a common question.
              </>
            )
          }
        </p>
        <div class="mt-6 flex flex-wrap gap-x-8 gap-y-4">
          <a href="/wiki/">{de ? 'Zum englischen Wiki →' : 'Explore the wiki →'}</a>
          <a href={pages.firstRun[lang]}>{de ? 'Zum Einsteigerguide' : 'Read the beginner guide'}</a>
          <a href={pages.faq[lang]}>{de ? 'Zu den häufigen Fragen' : 'Quick answers'}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="my-32" aria-labelledby="gameplay-trailer-heading">
    <div class="container">
      <div class="mx-auto max-w-5xl">
        <div class="mb-8 text-center">
          <h2 id="gameplay-trailer-heading" class="text-4xl sm:text-5xl md:text-6xl">
            {de ? 'Der Gameplay-Trailer' : 'Watch the gameplay trailer'}
          </h2>
          <p class="mt-4 text-xl">
            {
              de
                ? 'Schau dir an, wie du kämpfst, Beute sammelst und deinen Helden ausrüstest.'
                : 'See the dungeon, combat, loot, and progression in action.'
            }
          </p>
        </div>
        <a
          class="group relative block aspect-video overflow-hidden rounded-lg border border-solid border-current"
          href={trailerUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={de
            ? 'Gameplay-Trailer auf YouTube ansehen (öffnet in einem neuen Tab)'
            : 'Watch the Quick Dungeon Crawler gameplay trailer on YouTube (opens in a new tab)'}
        >
          <Image
            class="h-full w-full object-cover transition-transform duration-200 group-hover:scale-[1.02]"
            src={trailerThumbnail}
            alt=""
            width={1280}
            height={720}
            loading="lazy"
            decoding="async"
          />
          <span
            class="absolute inset-0 flex items-center justify-center bg-black/10 transition-colors group-hover:bg-black/20"
            aria-hidden="true"
          >
            <span class="flex h-20 w-20 items-center justify-center rounded-full bg-black/80 text-white shadow-lg">
              <svg class="ml-1 h-9 w-9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M8 5v14l11-7z"></path>
              </svg>
            </span>
          </span>
        </a>
        <p class="mt-4 text-center">
          <ExternalLink href={trailerUrl}>
            {de ? 'Auf YouTube ansehen' : 'Watch on YouTube'}
          </ExternalLink>
        </p>
      </div>
    </div>
  </section>

  <section class="my-32" aria-labelledby="why-play-heading">
    <div class="container">
      <div class="mb-12 text-center">
        <h2 id="why-play-heading" class="text-4xl sm:text-5xl md:text-6xl">
          {de ? 'Was dich im Dungeon erwartet' : "Why you'll keep coming back"}
        </h2>
        <p class="mt-4 text-xl">
          {
            de
              ? 'Ein Roguelite-Rollenspiel für die Kaffeepause und für lange Abende.'
              : 'A full roguelite RPG that fits into a coffee break.'
          }
        </p>
      </div>
      <div class="grid grid-cols-1 gap-12 md:grid-cols-2 xl:grid-cols-3">
        {
          features.map(({ icon, title, body }) => (
            <Feature {icon} {title}>
              {body}
            </Feature>
          ))
        }
      </div>
    </div>
  </section>

  <section class="my-32" aria-labelledby="player-reviews-heading">
    <div class="container">
      <div class="mb-12 text-center">
        <h2 id="player-reviews-heading" class="text-4xl sm:text-5xl md:text-6xl">
          {de ? 'Das sagen Spielerinnen und Spieler' : 'Player reviews'}
        </h2>
        <p class="mt-4 text-xl">
          {
            de
              ? '4,6 von 5 Sternen bei über 300 Bewertungen auf Google Play'
              : 'Rated 4.6★ by 300+ players on Google Play'
          }
        </p>
      </div>
      <ul class="grid list-none grid-cols-1 gap-6 p-0 sm:grid-cols-3">
        {
          reviews.map((review) => (
            <li class="review-card flex flex-col gap-4 rounded-lg border border-solid p-6">
              <p
                class="text-lg"
                aria-label={de ? `${review.rating} von 5 Sternen` : `Rated ${review.rating} out of 5 stars`}
              >
                <span aria-hidden="true">{'★'.repeat(review.rating) + '☆'.repeat(5 - review.rating)}</span>
              </p>
              <blockquote lang="en" class="grow text-lg italic">
                {review.quote}
              </blockquote>
              <footer class="text-sm">
                <cite class="block font-medium not-italic">
                  {review.author} · <time datetime={review.date}>{formatDate.format(new Date(review.date))}</time>
                </cite>
                <p class="mt-2">
                  <ExternalLink href={review.link}>{de ? 'Auf Google Play lesen' : 'Read on Google Play'}</ExternalLink>
                </p>
              </footer>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 text-center text-sm italic">
        {
          de
            ? 'Ausgewählte 5-Sterne-Bewertungen von Google Play im englischen Original.'
            : 'A selection of 5★ reviews from Google Play.'
        }
      </p>
    </div>
  </section>

  <section class="my-32" aria-labelledby="game-screenshots-heading">
    <div class="container">
      <h2 id="game-screenshots-heading" class="mb-12 text-center text-4xl sm:text-5xl md:text-6xl">
        {de ? 'Ein Blick ins Spiel' : 'See the game in action'}
      </h2>
      <div class="mx-auto grid max-w-3xl grid-cols-1 gap-6 sm:grid-cols-2">
        {
          [
            {
              src: bossCombatScreenshot,
              caption: de ? 'Im Kampf gegen die Ameisenkönigin' : 'Face the Ant Queen',
              alt: de
                ? 'Rowan und der Wolfswelpe greifen Llyrrad in einer von Fackeln beleuchteten Gruft an.'
                : 'Llyrrad guards a torchlit crypt as Rowan and the Wolf Pup attack.',
            },
            {
              src: characterBuildScreenshot,
              caption: de ? 'So sieht ein Paladin aus' : 'Build your Paladin',
              alt: de
                ? 'Die Charakteransicht des Paladins zeigt Heilung, Grundwerte, die passive Fähigkeit „Herz des Paladins“ und die Fluchstufe.'
                : 'The Paladin build screen shows healing, core stats, the Paladin’s Heart passive and Curse level.',
            },
          ].map(({ src, caption, alt }) => (
            <figure class="m-0">
              <Image
                class="h-auto w-full rounded-lg border border-solid border-current"
                {src}
                {alt}
                width={540}
                height={960}
                decoding="async"
                loading="lazy"
              />
              <figcaption class="mt-3 text-center font-semibold">{caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mt-32 mb-8">
    <div class="container">
      <h2 class="mb-16 text-6xl">{de ? 'Das Spiel in Zahlen' : 'Impact in numbers'}</h2>
      <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 md:grid-cols-4">
        <Counter count="30+" title={de ? 'Sterne' : 'Stars'} sub={de ? 'auf GitHub' : 'On GitHub'} />
        <Counter count="31" title={de ? 'Sprachen' : 'Languages'} sub={de ? 'im Spiel' : 'Fully translated'} />
        <Counter count={de ? '10.000+' : '10K+'} title="Downloads" sub={de ? 'bei Google Play' : 'On Google Play'} />
        <Counter count="3+" title={de ? 'Jahre' : 'Years'} sub={de ? 'in Entwicklung' : 'In development'} />
      </div>
    </div>
  </section>
  <CallToAction showBrowserPlay title={de ? 'Quick Dungeon Crawler spielen' : 'Play Quick Dungeon Crawler'} />
</DefaultLayout>

<style>
  .review-card {
    border-color: var(--border-color-subtle);
    background-color: light-dark(var(--color-neutral-200), var(--color-neutral-800));
  }

  .review-card > p:first-child {
    color: var(--link-color);
    letter-spacing: 0.15em;
  }
</style>
