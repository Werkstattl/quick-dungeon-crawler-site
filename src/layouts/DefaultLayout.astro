---
import '../styles/tailwind.css'
import '../assets/scss/index.scss'
import SiteMeta from '../components/SiteMeta.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import StructuredData from '../components/StructuredData.astro'
import { breadcrumbData, type Breadcrumb } from '../lib/structured-data'

interface Props {
  title?: string
  description?: string
  url?: string | URL
  image?: string
  author?: string
  type?: 'website' | 'article'
  showFooterDownload?: boolean
  structuredData?: Record<string, unknown>
  breadcrumbs?: Breadcrumb[]
}

const {
  title = 'Quick Dungeon Crawler',
  description = '',
  url = Astro.url,
  image = '/social-preview-image.png',
  author = 'Werkstattl',
  type = 'website',
  showFooterDownload = true,
  structuredData,
  breadcrumbs = [],
}: Props = Astro.props
---

<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />

    <!-- favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="alternate" type="application/rss+xml" title="Quick Dungeon Crawler Blog RSS" href="/blog/rss.xml" />

    <SiteMeta {title} {description} {url} {image} {author} {type} />
    {structuredData && <StructuredData data={structuredData} />}
    {breadcrumbs.length >= 2 && <StructuredData data={breadcrumbData(breadcrumbs, Astro.site ?? Astro.url)} />}
  </head>
  <body>
    <Header />
    <main id="main-content" transition:animate="fade">
      <slot />
    </main>
    <Footer showDownload={showFooterDownload} />
    <style lang="scss" is:global>
      // sticky footer on low content pages
      html,
      body {
        height: 100%;
      }

      body {
        display: flex;
        flex-direction: column;
        overflow-x: clip;

        main {
          flex: 1 0 auto;
        }

        footer {
          flex-shrink: 0;
        }
      }

      pre {
        border: 2px solid var(--link-color);
        border-radius: 0.35rem;
        padding: 1rem;
      }
    </style>
  </body>
</html>
