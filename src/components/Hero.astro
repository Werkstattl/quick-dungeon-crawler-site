---
import StoreBadges from './StoreBadges.astro'

/**
 * Hero Component
 *
 * @description A component that displays a hero section with a title, description, and image
 */
interface Props {
  /**
   * Source for the WebM video
   */
  srcWebm?: string
  /**
   * Source for the MP4 video
   */
  srcMp4?: string
  /**
   * Placeholder shown until the video has loaded
   */
  poster?: string
}

const { srcWebm = '/demo.webm', srcMp4 = '/demo.mp4', poster = '/demo-poster.webp' }: Props = Astro.props
---

<section class="hero my-24">
  <div class="container">
    <div class="grid grid-cols-1 items-center gap-16 lg:grid-cols-2 lg:gap-24">
      <div class="flex flex-col items-center gap-8 md:items-start">
        <h1 class="text-center text-6xl md:text-left lg:text-8xl">
          <slot>Loot, die, repeat — a fast mobile roguelite.</slot>
        </h1>
        <p class="text-center text-xl md:text-left">
          Casual · Offline play · No ads · 100% open-source
        </p>
        <div>
          <p class="mb-3 text-center md:text-left">Available on Android, iPhone, iPad and Mac with Apple silicon.</p>
          <StoreBadges class="justify-center md:justify-start" />
        </div>
      </div>
      <video
        class="h-auto w-full max-w-xs justify-self-center lg:max-w-[386px]"
        autoplay
        muted
        loop
        playsinline
        poster={poster}
        width="540"
        height="960"
        aria-hidden="true"
      >
        <source src={srcWebm} type="video/webm" />
        <source src={srcMp4} type="video/mp4" />
      </video>
    </div>
  </div>
</section>

<style lang="scss">
  h1 {
    text-wrap: unset;
  }

  .text-gradient {
    background: linear-gradient(
      315deg,
      light-dark(var(--color-primary-300), var(--color-secondary-100)) 25%,
      light-dark(var(--color-secondary-300), var(--color-primary-200))
    );
    background-clip: border-box;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
</style>
