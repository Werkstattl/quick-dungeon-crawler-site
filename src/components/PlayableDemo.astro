---
import { Image } from 'astro:assets'
import gameLogo from '@assets/img/game-logo.webp'

/**
 * PlayableDemo Component
 *
 * @description Poster that sends visitors straight to the live game
 *
 * Deliberately not an <iframe>: browsers partition storage for cross-origin frames, so an embedded
 * game would write its localStorage saves to a bucket that direct visits can never read back.
 */

const playUrl = 'https://dungeon.werkstattl.com/'
---

<section id="play" class="my-32" aria-labelledby="play-now-heading">
  <div class="container">
    <div class="mb-10 text-center">
      <h2 id="play-now-heading" class="text-4xl sm:text-5xl md:text-6xl">Play it right now</h2>
      <p class="mt-4 text-xl">No download, no sign-up — the full game runs in your browser.</p>
    </div>

    <div class="demo-device">
      <div class="demo-screen">
        <a class="demo-start" href={playUrl} aria-label="Play Quick Dungeon Crawler in your browser">
          <Image class="demo-logo" src={gameLogo} alt="" width={180} height={180} loading="lazy" decoding="async" />
          <span class="demo-title">Quick Dungeon Crawler</span>
          <span class="demo-cta">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M8 5v14l11-7z"></path>
            </svg>
            Play in your browser
          </span>
          <span class="demo-note">Loads in seconds · nothing to install</span>
        </a>
      </div>
    </div>

    <p class="mt-6 text-center">Your progress is saved on this device, so you can pick up right where you left off.</p>
  </div>
</section>

<style lang="scss">
  .demo-device {
    margin-inline: auto;
    box-shadow: 0 1.5rem 3rem light-dark(rgb(0 0 0 / 0.25), rgb(0 0 0 / 0.6));
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-h);
    background-color: var(--color-neutral-900);
    padding: var(--space-2xs);
    inline-size: min(100%, 26rem);
  }

  .demo-screen {
    position: relative;
    border-radius: calc(var(--radius-h) - var(--space-2xs));
    background: linear-gradient(360deg, #030303 10%, #1f1f1f 360%);
    aspect-ratio: 9 / 16;
    overflow: hidden;
  }

  .demo-start {
    display: flex;
    position: absolute;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: var(--space-s);
    cursor: pointer;
    inset: 0;
    border: 0;
    background: none;
    padding: var(--space-m);
    color: #fff;
    text-align: center;
    text-decoration: none;
  }

  .demo-logo {
    transition: transform var(--animation-speed-fast) var(--cubic-bezier);
    inline-size: min(45%, 11rem);
    block-size: auto;
  }

  .demo-start:where(:hover, :focus-visible) .demo-logo {
    transform: scale(1.05);
  }

  .demo-title {
    font-size: 1.375rem;
    line-height: 1.2;
  }

  .demo-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    transition: all var(--animation-speed-fast) var(--cubic-bezier);
    border: 2px solid var(--color-secondary-100);
    border-radius: var(--radius-s);
    background-color: var(--color-secondary-100);
    padding: var(--space-2xs) var(--space-s);
    color: var(--color-neutral-900);
    font-weight: 700;

    svg {
      inline-size: 1.25rem;
      block-size: 1.25rem;
    }
  }

  .demo-start:where(:hover, :focus-visible) .demo-cta {
    border-color: var(--color-secondary-300);
    background-color: var(--color-secondary-300);
  }

  .demo-note {
    color: var(--color-neutral-500);
    font-size: 0.875rem;
  }
</style>
