---
import StoreBadges from './StoreBadges.astro'
import { webGameUrl } from '../lib/stores'

/**
 * Hero Component
 *
 * @description A component that displays a hero section with a title, description, and image
 */
interface Props {
  /**
   * Source for the WebM video
   */
  srcWebm?: string
  /**
   * Source for the MP4 video
   */
  srcMp4?: string
  /**
   * Placeholder shown until the video has loaded
   */
  poster?: string
}

const { srcWebm = '/demo.webm', srcMp4 = '/demo.mp4', poster = '/demo-poster.webp' }: Props = Astro.props
---

<section class="hero mt-5 mb-16 lg:mt-10 lg:mb-24">
  <div class="container">
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-2 lg:gap-24">
      <div class="flex flex-col items-center gap-4 text-center lg:items-start lg:gap-6 lg:text-left">
        <h1 class="text-4xl leading-none text-balance sm:text-6xl lg:text-8xl">
          <slot>Loot, die, repeat.</slot>
        </h1>
        <p class="text-lg text-balance sm:text-xl">
          Casual · Offline play · No ads · <span class="inline-block">100% open-source</span>
        </p>
        <div class="flex flex-col items-center gap-4 lg:items-start">
          <a class="button color-secondary" href={webGameUrl}>Play in your browser</a>
          <StoreBadges class="justify-center lg:justify-start" />
        </div>
      </div>
      <video
        class="h-auto w-full max-w-[17rem] justify-self-center sm:max-w-xs lg:max-w-[360px]"
        autoplay
        muted
        loop
        playsinline
        poster={poster}
        width="540"
        height="960"
        aria-hidden="true"
      >
        <source src={srcWebm} type="video/webm" />
        <source src={srcMp4} type="video/mp4" />
      </video>
    </div>
  </div>
</section>
