---
import { pageLanguage } from '../lib/languages'
import { appStoreUrl, googlePlayUrl } from '../lib/stores'

interface Props {
  class?: string
  googlePlayLink?: string
  googlePlayText?: string
}

const de = pageLanguage(Astro.url) === 'de'
const {
  class: className,
  googlePlayLink = googlePlayUrl,
  googlePlayText = de ? 'Bei Google Play laden – für Android' : 'Get it on Google Play for Android',
}: Props = Astro.props
---

<div class:list={['flex flex-wrap items-center gap-3', className]}>
  {
    de ? (
      <>
        <a class="store-link" href={googlePlayLink} aria-label={googlePlayText} target="_blank" rel="noopener noreferrer">
          Bei Google Play laden
        </a>
        <a
          class="store-link"
          href={appStoreUrl}
          aria-label="Im App Store laden – für iPhone, iPad und Mac mit Apple Chip"
          target="_blank"
          rel="noopener noreferrer"
        >
          Im App Store laden
        </a>
      </>
    ) : (
      <>
        <a href={googlePlayLink} target="_blank" rel="noopener noreferrer">
          <img src="/google-play-badge.png" alt={googlePlayText} width="564" height="168" class="h-11 w-auto" />
        </a>
        <a href={appStoreUrl} target="_blank" rel="noopener noreferrer">
          <img
            src="/app-store-badge.svg"
            alt="Download on the App Store for iPhone, iPad and Mac with Apple silicon"
            width="120"
            height="40"
            class="h-11 w-auto"
          />
        </a>
      </>
    )
  }
</div>

<style>
  .store-link {
    display: inline-flex;
    align-items: center;
    border: 1px solid currentColor;
    border-radius: 0.5rem;
    padding: 0.35rem 0.75rem;
    min-height: 2.75rem;
    color: inherit;
    font-weight: 600;
    text-decoration: none;
  }

  .store-link:hover,
  .store-link:focus-visible {
    text-decoration: underline;
  }
</style>
