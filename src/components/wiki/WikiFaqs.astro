---
import { germanFaq } from '../../translations/de/faq'
import { pages, pageLanguage } from '../../lib/languages'
import { getWikiArticles, wikiUrl } from '../../lib/wiki'
const de = pageLanguage(Astro.url) === 'de'
const articles = await getWikiArticles()
const entries = articles.flatMap(({ id, data }) => {
  const entry = de ? germanFaq[data.faqId] : data
  if (!entry) return []
  const translated = de && id === 'getting-started'
  const guide = translated ? pages.firstRun.de : wikiUrl(id)
  return [{ ...entry, id: data.faqId, guide, translated }]
})
---

<div class="wiki-faqs">
  {
    entries.map((entry) => (
      <details id={entry.id}>
        <summary>{entry.question}</summary>
        <div class="wiki-faq-answer">
          <p>{entry.answer}</p>
          <div class="wiki-faq-links">
            <a href={`${entry.guide}#quick-answer`}>{de ? (entry.translated ? 'Zum Einsteigerguide →' : 'Zum ausführlichen Guide (Englisch) →') : 'Read the full guide →'}</a>
            <a href={`#${entry.id}`} aria-label={de ? `Direktlink: ${entry.question}` : `Direct link: ${entry.question}`}>
              {de ? 'Link zu dieser Antwort' : 'Link to this answer'}
            </a>
          </div>
        </div>
      </details>
    ))
  }
</div>
<script>
  function openLinkedAnswer() {
    let id: string
    try {
      id = decodeURIComponent(window.location.hash.slice(1))
    } catch {
      return
    }
    const target = document.getElementById(id)
    if (target instanceof HTMLDetailsElement && target.closest('.wiki-faqs')) target.open = true
  }
  document.addEventListener('astro:page-load', openLinkedAnswer)
  window.addEventListener('hashchange', openLinkedAnswer)
</script>
