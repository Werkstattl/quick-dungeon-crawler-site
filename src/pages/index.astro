---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import Counter from '@components/Counter.astro'
import Feature from '@components/Feature.astro'
import ExternalLink from '@components/ExternalLink.astro'
import characterBuildScreenshot from '@assets/img/character-build.webp'
import explorationScreenshot from '@assets/img/exploration.webp'
import bossCombatScreenshot from '@assets/img/boss-combat.webp'
import trailerThumbnail from '@assets/img/qdc-gameplay-trailer.webp'
import { Image } from 'astro:assets'

const pageTitle = 'Quick Dungeon Crawler – Free Offline Roguelite RPG for Android'
const pageDescription =
  'Quick Dungeon Crawler – a casual roguelite for mobile and web. Loot, die, repeat. No ads, offline play, open-source.'
const googlePlayUrl =
  'https://play.google.com/store/apps/details?id=com.thomaspeissl.quick_dungeon_crawler_od.twa'
const trailerUrl = 'https://www.youtube.com/watch?v=CDArsS_qMyc'
const siteUrl = Astro.site ?? new URL(Astro.url.origin)

const reviewsBaseUrl = `${googlePlayUrl}&showAllReviews=true&gl=EU&hl=en_US&reviewId=`

const reviews = [
  {
    rating: 5,
    quote:
      'Pretty good experience so far, looks like a real gem in this day in age! Props to the devs, I can’t wait to see what they add next!',
    author: 'Rick A',
    date: '22 August 2026',
    link: `${reviewsBaseUrl}0bf68797-f59c-4b6e-a053-9070371759de`,
  },
  {
    rating: 5,
    quote:
      'Simply addictive. Easy to load game that you can load offline. The gaming mechanisms is simple, retro like, which makes it very easy to turn off brain, read text, chill and fight monsters in the dungeon.',
    author: 'Grace Yeung',
    date: '8 January 2026',
    link: `${reviewsBaseUrl}2e85f77a-18ae-4236-8738-83ce8050dd4d`,
  },
  {
    rating: 5,
    quote:
      'Really good RPG. You can build your character with a great variety of attributes. The game gets harder the more you progress, so manage your stats and equipment wisely.',
    author: 'Samukazai',
    date: '27 October 2025',
    link: `${reviewsBaseUrl}82821435-2697-4335-b6ae-adb6effd6336`,
  },
  {
    rating: 5,
    quote:
      'The developers are incredible! They listen to feedback and will implement it if it jives with their vision. I cannot say a bad thing. I’ll definitely get part 2 if they make it.',
    author: 'Joe Sobczak',
    date: '10 October 2025',
    link: `${reviewsBaseUrl}85d8a92f-0bed-4383-bc9d-0137ecde56ae`,
  },
  {
    rating: 5,
    quote:
      'Found off a reddit post and gave it a try for a few hours. first impressions are that it’s pretty simple but fun text based rpg/clicker. No major IAPs or Ads that bog down the game which is always welcomed',
    author: 'Matt S',
    date: '2 September 2025',
    link: `${reviewsBaseUrl}15f751aa-f66f-457e-a7a9-bea305ec0e2c`,
  },
  {
    rating: 5,
    quote:
      'great game simple quick and effective. you’re able to take this game on the go without committing too much time or energy! love this and will recommend it!',
    author: 'Welly C',
    date: '27 July 2025',
    link: `${reviewsBaseUrl}40d7cc19-8e41-468f-bb70-383313a35efb`,
  },
]

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: 'Quick Dungeon Crawler',
  alternateName: 'Quick Dungeon Crawler on Demand',
  url: siteUrl.href,
  image: new URL('/social-preview-image.png', siteUrl).href,
  description: pageDescription,
  genre: ['Roguelite', 'Role-playing game', 'Dungeon crawler'],
  gamePlatform: ['Android', 'Web browser'],
  applicationCategory: 'GameApplication',
  operatingSystem: 'Android, Web browser',
  author: {
    '@type': 'Organization',
    name: 'Werkstattl',
    url: 'https://werkstattl.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Werkstattl',
    url: 'https://werkstattl.com',
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
    url: googlePlayUrl,
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.5',
    ratingCount: '260',
    bestRating: '5',
    worstRating: '1',
  },
  trailer: {
    '@type': 'VideoObject',
    name: 'Quick Dungeon Crawler gameplay trailer',
    description: 'See the dungeon, combat, loot, and progression in action.',
    thumbnailUrl: new URL(trailerThumbnail.src, siteUrl).href,
    uploadDate: '2026-08-01',
    contentUrl: trailerUrl,
    embedUrl: 'https://www.youtube.com/embed/CDArsS_qMyc',
  },
}
---

<DefaultLayout title={pageTitle} description={pageDescription}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <Hero />

  <section class="my-32" aria-labelledby="gameplay-trailer-heading">
    <div class="container">
      <div class="mx-auto max-w-5xl">
        <div class="mb-8 text-center">
          <h2 id="gameplay-trailer-heading" class="text-4xl sm:text-5xl md:text-6xl">Watch the gameplay trailer</h2>
          <p class="mt-4 text-xl">See the dungeon, combat, loot, and progression in action.</p>
        </div>
        <a
          class="group relative block aspect-video overflow-hidden rounded-lg border border-solid border-current"
          href={trailerUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Watch the Quick Dungeon Crawler gameplay trailer on YouTube (opens in a new tab)"
        >
          <Image
            class="h-full w-full object-cover transition-transform duration-200 group-hover:scale-[1.02]"
            src={trailerThumbnail}
            alt=""
            width={1280}
            height={720}
            loading="lazy"
            decoding="async"
          />
          <span
            class="absolute inset-0 flex items-center justify-center bg-black/10 transition-colors group-hover:bg-black/20"
            aria-hidden="true"
          >
            <span class="flex h-20 w-20 items-center justify-center rounded-full bg-black/80 text-white shadow-lg">
              <svg class="ml-1 h-9 w-9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M8 5v14l11-7z"></path>
              </svg>
            </span>
          </span>
        </a>
        <p class="mt-4 text-center">
          <ExternalLink href={trailerUrl}>
            Watch on YouTube
          </ExternalLink>
        </p>
      </div>
    </div>
  </section>

  <section class="my-32" aria-labelledby="why-play-heading">
    <div class="container">
      <div class="mb-12 text-center">
        <h2 id="why-play-heading" class="text-4xl sm:text-5xl md:text-6xl">Why you'll keep coming back</h2>
        <p class="mt-4 text-xl">A full roguelite RPG that fits into a coffee break.</p>
      </div>
      <div class="grid grid-cols-1 gap-12 md:grid-cols-2 xl:grid-cols-3">
        <Feature icon="lucide:dices" title="Endless randomized runs">
          Every descent generates new floors, enemies and loot, so no two runs play the same.
        </Feature>
        <Feature icon="lucide:swords" title="Build your character">
          Pick a class, spend your stats, choose a passive — and take a Curse when you want a harder run.
        </Feature>
        <Feature icon="lucide:hammer" title="Forge your gear">
          Upgrade, reroll and lock equipment stats in the Forge to push your build past the next boss.
        </Feature>
        <Feature icon="lucide:paw-print" title="Fight with companions">
          Recruit companions that fight at your side and add bonuses to the rest of your run.
        </Feature>
        <Feature icon="lucide:wifi-off" title="Plays offline">
          Once loaded, the whole game runs on your device — on the train, on a plane, anywhere.
        </Feature>
        <Feature icon="lucide:heart-handshake" title="No ads, no paywalls">
          Free and 100% open-source, with no ads, no forced purchases and no tracking.
        </Feature>
      </div>
    </div>
  </section>

  <section class="my-32" aria-labelledby="player-reviews-heading">
    <div class="container">
      <div class="mb-12 text-center">
        <h2 id="player-reviews-heading" class="text-4xl sm:text-5xl md:text-6xl">Player reviews</h2>
        <p class="mt-4 text-xl">Rated 4.5★ by 260+ players on Google Play</p>
      </div>
      <ul class="grid list-none grid-cols-1 gap-6 p-0 sm:grid-cols-3">
        {
          reviews.map((review) => (
            <li class="review-card flex flex-col gap-4 rounded-lg border border-solid p-6">
              <p class="text-lg" aria-label={`Rated ${review.rating} out of 5 stars`}>
                <span aria-hidden="true">{'★'.repeat(review.rating) + '☆'.repeat(5 - review.rating)}</span>
              </p>
              <blockquote class="grow text-lg italic">{review.quote}</blockquote>
              <footer class="text-sm">
                <cite class="block font-medium not-italic">
                  {review.author} · {review.date}
                </cite>
                <p class="mt-2">
                  <ExternalLink href={review.link}>Read on Google Play</ExternalLink>
                </p>
              </footer>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 text-center text-sm italic">A selection of 5★ reviews from Google Play.</p>
    </div>
  </section>

  <section class="my-32" aria-labelledby="game-screenshots-heading">
    <div class="container">
      <h2 id="game-screenshots-heading" class="mb-12 text-center text-4xl sm:text-5xl md:text-6xl">
        See the game in action
      </h2>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
        <Image
          class="h-auto w-full rounded-lg border border-solid border-current"
          src={characterBuildScreenshot}
          alt="Character creation showing Paladin stats, class, passive, and Curse selection"
          width={540}
          height={960}
          decoding="async"
          loading="lazy"
        />
        <Image
          class="h-auto w-full rounded-lg border border-solid border-current"
          src={explorationScreenshot}
          alt="Dungeon exploration showing player stats, companion bonuses, and the event log"
          width={540}
          height={960}
          decoding="async"
          loading="lazy"
        />
        <Image
          class="h-auto w-full rounded-lg border border-solid border-current"
          src={bossCombatScreenshot}
          alt="Boss combat against the Ant Queen with a companion and class ability"
          width={540}
          height={960}
          decoding="async"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="mt-32 mb-8">
    <div class="container">
      <h2 class="mb-16 text-6xl">Impact in numbers</h2>
      <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 md:grid-cols-4">
        <Counter count="30+" title="Stars" sub="On GitHub" />
        <Counter count="31" title="Languages" sub="Fully translated" />
        <Counter count="5K+" title="Downloads" sub="On Google Play" />
        <Counter count="3+" title="Years" sub="In development" />
      </div>
    </div>
  </section>
</DefaultLayout>

<style>
  .review-card {
    border-color: var(--border-color-subtle);
    background-color: light-dark(var(--color-neutral-200), var(--color-neutral-800));
  }

  .review-card > p:first-child {
    color: var(--link-color);
    letter-spacing: 0.15em;
  }
</style>
