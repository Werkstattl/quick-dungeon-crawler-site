---
import { pageLanguage, pages } from '../lib/languages'
import CallToAction from './CallToAction.astro'

/**
 * Footer Component
 *
 * @description A component that displays the footer of the website
 */
const de = pageLanguage(Astro.url) === 'de'
const currentYear = new Date().getFullYear()
interface Props {
  showDownload?: boolean
}
const { showDownload = true } = Astro.props
---

<footer>
  {showDownload && <CallToAction />}
  <section class="py-20">
    <h2 class="sr-only">{de ? 'Fußzeile' : 'Footer'}</h2>
    <div class="container grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-4">
        <h3 class="text-2xl font-bold">Navigation</h3>
        <ul class="flex flex-col gap-2">
          <li><a href={de ? pages.home.de : pages.home.en}>{de ? 'Startseite' : 'Home'}</a></li>
          {de && <>
            <li><a href={pages.firstRun.de}>Einsteigerguide</a></li>
            <li><a href={pages.faq.de}>Häufige Fragen</a></li>
          </>}
          <li><a href="/wiki/">{de ? 'Wiki (Englisch)' : 'Wiki & Guides'}</a></li>
          <li><a href="/blog">{de ? 'Blog (Englisch)' : 'Blog'}</a></li>
          <li><a href="/about">{de ? 'Über das Spiel (Englisch)' : 'About'}</a></li>
          <li><a href="/press">{de ? 'Presse (Englisch)' : 'Press'}</a></li>
        </ul>
      </div>
      <div class="flex flex-col gap-4">
                     <h3 class="text-2xl font-bold">Community</h3>
                     <ul class="flex flex-col gap-2">
                       <li><a href="https://discord.gg/U4DvQT3qfQ">Discord</a></li>
                       <li><a href="https://www.reddit.com/r/QuickDungeonCrawler/">Reddit</a></li>
                       <li><a href="https://bsky.app/profile/quickdungeoncrawl.bsky.social">Bluesky</a></li>
                       <li><a href="https://mastodon.gamedev.place/@quickdungeoncrawler" rel="me">Mastodon</a></li>
                     </ul>
                 </div>
      <div class="flex flex-col gap-4">
              <h3 class="text-2xl font-bold">{de ? 'Rechtliches' : 'Legal'}</h3>
              <ul class="flex flex-col gap-2">
                <li><a href="/privacy">{de ? 'Datenschutz (Englisch)' : 'Privacy'}</a></li>
                <li><a href="/legal-notice">{de ? 'Impressum (Englisch)' : 'Legal Notice'}</a></li>
              </ul>
            </div>
    </div>
  </section>
  <section class="py-8">
    <div class="container flex flex-col gap-4 md:flex-row md:justify-between">
      <p>
        &copy; {currentYear} - <a href="https://werkstattl.com">Werkstattl</a>.
      </p>
    </div>
  </section>
</footer>

<style>
  section {
    border-top: 1px solid var(--border-color-subtle);
  }
</style>
