---
import { Icon } from 'astro-icon/components'
const { compact = false } = Astro.props
---

<wiki-search class:list={['wiki-search', { 'wiki-search-compact': compact }]}>
  <form role="search" aria-label="Search the wiki">
    <label for="wiki-search-input">What would you like to know?</label>
    <div class="wiki-search-field">
      <Icon name="lucide:search" aria-hidden="true" />
      <input
        id="wiki-search-input"
        type="search"
        name="q"
        placeholder="Try curse, gold, refining, luck…"
        autocomplete="off"
        aria-describedby="wiki-search-status"
        disabled
      />
      <button type="submit" disabled>Search</button>
    </div>
  </form>
  <p id="wiki-search-status" class="wiki-search-status" role="status" aria-live="polite"></p>
  <ol class="wiki-search-results" aria-label="Search results" hidden></ol>
  <noscript><p>Search needs JavaScript. You can browse every guide and FAQ using the links on this page.</p></noscript>
</wiki-search>

<script is:inline type="module" src="/wiki-search.js"></script>
