---
import { pages, pageLanguage } from '../../lib/languages'
import { getWikiArticles, wikiCategories, wikiUrl } from '../../lib/wiki'
const { current = '' } = Astro.props
const de = pageLanguage(Astro.url) === 'de'
const articles = de ? [] : await getWikiArticles()
---

{de ? <nav aria-label="Wiki-Themen" class="wiki-navigation">
  <div class="wiki-nav-group">
    <p>Wiki &amp; Spieltipps</p>
    <ul>
      <li><a href={pages.firstRun.de} aria-current={current === 'getting-started' ? 'page' : undefined}>Einsteigerguide</a></li>
      <li><a href={pages.faq.de}>Häufige Fragen</a></li>
    </ul>
  </div>
  <a class="wiki-overview-link" href="/wiki/">Zum englischen Wiki →</a>
</nav> : <nav aria-label="Wiki topics" class="wiki-navigation">
  <a class="wiki-overview-link" href="/wiki/">← Wiki overview</a>
  {
    wikiCategories.map((category) => (
      <div class="wiki-nav-group">
        <p>{category.title}</p>
        <ul>
          {articles
            .filter((article) => article.data.category === category.id)
            .map((article) => (
              <li>
                <a href={wikiUrl(article.id)} aria-current={current === article.id ? 'page' : undefined}>
                  {article.data.navTitle}
                </a>
              </li>
            ))}
        </ul>
      </div>
    ))
  }
  <a class="wiki-overview-link" href="/wiki/faq/" aria-current={current === 'faq' ? 'page' : undefined}
    >Frequently asked questions</a
  >
</nav>}
