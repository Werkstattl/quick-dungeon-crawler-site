---
import Navigation from '../components/Navigation.astro'
import { DarkMode, SkipLink } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'

/**
 * Header Component
 *
 * @description A component that displays the header of the website
 */
---

<header>
  <SkipLink />
  <Navigation>
    <li class="menu-item">
      <a href="/">Home</a>
    </li>
    <li class="menu-item">
      <a href="/wiki/">Wiki &amp; Guides</a>
    </li>
    <li class="menu-item">
      <a href="/blog/">Blog</a>
    </li>
    <li class="menu-item">
      <a href="/about">About</a>
    </li>
    <li class="menu-item">
      <a href="/press">Press</a>
    </li>
    <li class="menu-item type-icon animate-rotate">
      <a href="/blog/rss.xml" aria-label="Subscribe to RSS">
        <Icon aria-hidden="true" name="lucide:rss" />
        <span class="sr-only">Subscribe to the RSS feed</span>
      </a>
    </li>
    <li class="menu-item type-icon animate-rotate">
          <a href="https://www.reddit.com/r/QuickDungeonCrawler/">
            <Icon aria-hidden="true" name="fa-brands:reddit" />
            <span class="sr-only">Go to the Reddit subreddit</span>
          </a>
        </li>
    <li class="menu-item type-icon animate-rotate">
      <a href="https://bsky.app/profile/quickdungeoncrawl.bsky.social">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill="currentColor" d="M5.202 2.857C7.954 4.922 10.913 9.11 12 11.358c1.087-2.247 4.046-6.436 6.798-8.501C20.783 1.366 24 .213 24 3.883c0 .732-.42 6.156-.667 7.037c-.856 3.061-3.978 3.842-6.755 3.37c4.854.826 6.089 3.562 3.422 6.299c-5.065 5.196-7.28-1.304-7.847-2.97c-.104-.305-.152-.448-.153-.327c0-.121-.05.022-.153.327c-.568 1.666-2.782 8.166-7.847 2.97c-2.667-2.737-1.432-5.473 3.422-6.3c-2.777.473-5.899-.308-6.755-3.369C.42 10.04 0 4.615 0 3.883c0-3.67 3.217-2.517 5.202-1.026"/></svg>
        <span class="sr-only">Follow Quick Dungeon Crawler on Bluesky</span>
      </a>
    </li>
    <li class="menu-item type-icon animate-rotate">
      <a href="https://discord.gg/U4DvQT3qfQ">
        <Icon aria-hidden="true" name="fa-brands:discord" />
        <span class="sr-only">Join the Quick Dungeon Crawler Discord server</span>
      </a>
    </li>
    <li class="menu-item type-icon animate-rotate">
      <a href="https://github.com/Werkstattl/quick-dungeon-crawler-rpg-od">
        <Icon aria-hidden="true" name="lucide:github" />
        <span class="sr-only">Go to the GitHub page</span>
      </a>
    </li>
    <li class="menu-item type-icon animate-rotate">
      <DarkMode>
        <Icon aria-hidden="true" name="lucide:moon" slot="light" />
        <Icon aria-hidden="true" name="lucide:sun" slot="dark" />
      </DarkMode>
    </li>
  </Navigation>
</header>

<style lang="scss" is:global>
  header {
    .type-icon {
      display: block;
      margin-inline: -7px;

      svg {
        inline-size: 30px;
        block-size: 30px;
      }
    }
  }
</style>
