---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import JsonLd from '@components/JsonLd.astro'
import PageHeader from '@components/PageHeader.astro'
import SocialShares from '@components/SocialShares.astro'
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'

export async function getStaticPaths() {
  const blog = await getCollection('blog')

  return blog.map((post, index) => {
    return {
      params: { post: post.id },
      props: { post: blog[index] },
    }
  })
}

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { Content } = await render(post)

const author = {
  name: 'by ' + post.data.author,
  image: '/default-author-image.png',
  bio: 'developer @ Werkstattl',
}

const siteUrl = Astro.site ?? Astro.url
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href
const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: new URL(post.data.cover.src, siteUrl).href,
  ...(post.data.date ? { datePublished: post.data.date } : {}),
  inLanguage: 'en',
  author: { '@type': 'Person', name: post.data.author },
  publisher: { '@type': 'Organization', name: 'Werkstattl', url: 'https://werkstattl.com' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
}
const blogBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl.href },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', siteUrl).href },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: canonicalUrl },
  ],
}
---

<DefaultLayout
  title={post.data.title}
  description={post.data.description}
  url={Astro.url}
  image={post.data.cover.src}
  imageAlt={post.data.coverAlt}
  type="article"
>
  <JsonLd data={[blogPosting, blogBreadcrumb]} />
  <PageHeader
    title={post.data.title}
    subtitle={post.data.description}
    author={author}
    bgType="bordered"
    featuredImage={post.data.cover}
    featuredImageAlt={post.data.coverAlt}
    featuredImageLayout={post.data.coverLayout}
    date={post.data.date}
  />
  <section class="my-12">
    <div class="narrow space-content container">
      <Content />
    </div>
  </section>
  <section class="my-12">
    <div class="narrow space-content container">
      <h2>Share this post</h2>
      <p>Like this post? Share it with your network!</p>
      <SocialShares />
    </div>
  </section>
</DefaultLayout>

<style lang="scss" is:global>
  .narrow {
    margin-inline: auto;
    max-width: 65ch;
  }
</style>
