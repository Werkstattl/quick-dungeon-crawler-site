---
import type { CollectionEntry } from 'astro:content'
import WikiArticle from '../../components/wiki/WikiArticle.astro'
import { getWikiArticles } from '../../lib/wiki'

export async function getStaticPaths() {
  return (await getWikiArticles()).map((article) => ({ params: { slug: article.id }, props: { article } }))
}
interface Props {
  article: CollectionEntry<'wiki'>
}
const { article } = Astro.props
---
<WikiArticle {article} />
