---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import SocialShares from '@components/SocialShares.astro'
import BlogPlayCard from '@components/BlogPlayCard.astro'
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import { publisher } from '../../lib/structured-data'

export async function getStaticPaths() {
  const blog = await getCollection('blog')

  return blog.map((post, index) => {
    return {
      params: { post: post.id },
      props: { post: blog[index] },
    }
  })
}

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { Content } = await render(post)
const siteUrl = Astro.site ?? Astro.url
const pageUrl = new URL(Astro.url.pathname, siteUrl).href
const structuredData = {
  '@type': 'BlogPosting',
  '@id': `${pageUrl}#article`,
  url: pageUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  headline: post.data.title,
  description: post.data.description,
  image: new URL(post.data.cover.src, siteUrl).href,
  author: { '@type': 'Person', name: post.data.author },
  publisher,
  datePublished: post.data.date,
  inLanguage: 'en',
  about: { '@id': new URL('/#game', siteUrl).href },
}
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: post.data.title, path: Astro.url.pathname },
]

const author = {
  name: 'by ' + post.data.author,
  image: '/default-author-image.png',
  bio: 'developer @ Werkstattl',
}
---

<DefaultLayout
  title={post.data.title}
  description={post.data.description}
  url={Astro.url}
  image={post.data.cover.src}
  type="article"
  showFooterDownload={false}
  {structuredData}
  {breadcrumbs}
>
  <PageHeader
    title={post.data.title}
    subtitle={post.data.description}
    author={author}
    bgType="bordered"
    featuredImage={post.data.cover}
    featuredImageAlt={post.data.coverAlt}
    featuredImageLayout={post.data.coverLayout}
    date={post.data.date}
  />
  <section class="my-12">
    <div class="narrow space-content container">
      <Content />
    </div>
  </section>
  <div class="narrow container my-12">
    <BlogPlayCard />
  </div>
  <section class="my-12">
    <div class="narrow space-content container">
      <h2>Share this post</h2>
      <p>Like this post? Share it with your network!</p>
      <SocialShares />
    </div>
  </section>
</DefaultLayout>

<style lang="scss" is:global>
  .narrow {
    margin-inline: auto;
    max-width: 65ch;
  }
</style>
